# /opt/anvil/forge.env — Anvil.Forge configuration.
#
# Read docs/RATE_BUDGET.md before touching FORGE_HISCORES_RPS. It is a rate against Jagex's
# infrastructure, which we do not pay for and cannot be granted more of by asking; exceeding what
# they tolerate blocks the box's IP and takes tracking down for EVERY clan at once.

# Pinned by CI to the exact image it built. Edit + `docker compose up -d anvil-forge` to roll back.
FORGE_IMAGE=ghcr.io/ahmedfathy2001/anvil-forge:stable

DATABASE_URL=postgres://anvil:CHANGEME@anvil-postgres:5432/anvil

# Wise Old Man runs the real thing at 4. We sit marginally above because we additionally need to
# detect tile completions mid-event for players without the plugin.
FORGE_HISCORES_RPS=5
FORGE_HISCORES_BURST=10
FORGE_WORKERS=8

# Identify ourselves to Jagex. Being identifiable is the cheapest insurance there is: an operator
# who can see who we are can ask us to slow down instead of simply blocking us.
FORGE_USER_AGENT=Anvil.Forge/1.0 (+https://anvilosrs.com; ahmedfathy075@gmail.com)

# Start with the sweep OFF and the queue ON: the Discord queue is independent of the schema work,
# while the sweep needs the player mapping populated first. Flip FORGE_ENABLE_SWEEP once
# forge_players has been reconciled and a dry run looks right.
FORGE_ENABLE_SWEEP=false
FORGE_ENABLE_EDGE=false
FORGE_ENABLE_DISCORD=true

# Poll for real, write nothing but the run log. How to watch actual behaviour and actual request
# rates against production data before letting it touch a row.
FORGE_DRY_RUN=false

FORGE_HTTP_ADDR=:8080
FORGE_LOG_LEVEL=info
